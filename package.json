{
    "name": "treinamento-fg",
    "version": "1.0.0",
    "description": "",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.build.json && tsc-alias",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "prepare": "husky"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^9.1.0",
        "@prisma/client": "^6.19.3",
        "bcrypt": "^6.0.0",
        "dotenv": "^16.6.1",
        "express": "^4.22.2",
        "jsonwebtoken": "^9.0.3",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.20.1",
        "@types/supertest": "^7.2.1",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.6",
        "prisma": "^6.19.3",
        "supertest": "^7.2.2",
        "tsc-alias": "^1.9.1",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
